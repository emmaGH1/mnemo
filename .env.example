# Copy this file to .env and fill in your key
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional — change the port the Express server listens on (default: 3000)
PORT=3000

# ─── x402 Payment Gate ────────────────────────────────────────────────────────

# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# REPLACE BEFORE ASP REGISTRATION — this is the wallet that receives $0.15 USDT
# per /mcp call from OKX's facilitator. The zero address below is a safe
# deploy-time placeholder ONLY. If you go live with 0x000...000, all payments
# are permanently unclaimable. Swap in your real OKX Agentic Wallet address.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
AGENTIC_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# OKX API credentials — needed by OKXFacilitatorClient to verify & settle
# payments on-chain. Without these, the server still correctly issues HTTP 402
# for unpaid requests, but cannot complete payment verification on paid ones.
# Get your keys at: https://www.okx.com/developer/apps
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase
